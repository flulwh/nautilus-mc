# Nautilus 面板环境变量（复制为 /etc/nautilus/nautilus.env，chmod 600）
# 全部配置也可写在当前工作目录的 .env 中，前缀固定为 NAUTILUS_。

# --- 首次启动：必须设置，用于创建初始管理员 ---
NAUTILUS_BOOTSTRAP_ADMIN_USER=admin
NAUTILUS_BOOTSTRAP_ADMIN_PASSWORD=change-me-please

# --- 监听 ---
NAUTILUS_HOST=127.0.0.1
NAUTILUS_PORT=8199
# 反向代理子路径部署时填写，例如 /panel
NAUTILUS_ROOT_PATH=

# --- 数据目录（数据库、RBAC 文件、所有服务端文件夹）---
NAUTILUS_DATA_DIR=/opt/nautilus/data

# --- 安全 ---
# 留空则首次启动自动生成并持久化到 <data>/.secret
NAUTILUS_SECRET_KEY=
# 仅当面板通过 HTTPS 访问时改为 true
NAUTILUS_COOKIE_SECURE=false
NAUTILUS_TOKEN_TTL_MINUTES=120
# 允许自助注册（默认关闭，账号由管理员创建）
NAUTILUS_ALLOW_REGISTRATION=false
# 仅信任来自这些地址的 X-Forwarded-For；反代在本机时保持 127.0.0.1
NAUTILUS_FORWARDED_ALLOW_IPS=127.0.0.1

# --- 运行时 ---
NAUTILUS_JAVA=java
NAUTILUS_METRICS_INTERVAL=3.0
NAUTILUS_METRICS_POINTS=600
NAUTILUS_MAX_LOG_LINES=2000
NAUTILUS_STOP_GRACE_SECONDS=30
NAUTILUS_LOG_LEVEL=info
